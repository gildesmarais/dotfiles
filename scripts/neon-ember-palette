#!/usr/bin/env ruby
# frozen_string_literal: true

# neon-ember-palette
#
# Generates the Ghostty neon-ember theme from the #ff8800 accent in OKLCH:
# every ANSI hue shares one lightness and chroma per tier, and the neutrals
# are tinted toward the accent. Contrast against the background goes to stderr.
#
#   scripts/neon-ember-palette > config/ghostty/themes/neon-ember
#
# vim/colors/neon-ember.vim and the lazygit/lazydocker borders copy these
# values; update them after a change.

ACCENT = '#ff8800'
HUES = { 1 => 25, 2 => 140, 3 => 90, 4 => 255, 5 => 340, 6 => 195 }.freeze
BRIGHT_LIGHTNESS = 0.84
CHROMA = 0.16

def to_linear(c) = c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055)**2.4
def to_srgb(c) = c <= 0.0031308 ? 12.92 * c : (1.055 * (c**(1 / 2.4))) - 0.055

def hex_to_oklch(hex)
  r, g, b = hex.delete('#').scan(/../).map { to_linear(_1.to_i(16) / 255.0) }
  l = Math.cbrt((0.4122214708 * r) + (0.5363325363 * g) + (0.0514459929 * b))
  m = Math.cbrt((0.2119034982 * r) + (0.6806995451 * g) + (0.1073969566 * b))
  s = Math.cbrt((0.0883024619 * r) + (0.2817188376 * g) + (0.6299787005 * b))
  a = (1.9779984951 * l) - (2.4285922050 * m) + (0.4505937099 * s)
  bb = (0.0259040371 * l) + (0.7827717662 * m) - (0.8086757660 * s)
  [(0.2104542553 * l) + (0.7936177850 * m) - (0.0040720468 * s),
   Math.hypot(a, bb), (Math.atan2(bb, a) * 180 / Math::PI) % 360]
end

def oklch_to_linear_rgb(lightness, chroma, hue)
  a = chroma * Math.cos(hue * Math::PI / 180)
  b = chroma * Math.sin(hue * Math::PI / 180)
  l = (lightness + (0.3963377774 * a) + (0.2158037573 * b))**3
  m = (lightness - (0.1055613458 * a) - (0.0638541728 * b))**3
  s = (lightness - (0.0894841775 * a) - (1.2914855480 * b))**3
  [(4.0767416621 * l) - (3.3077115913 * m) + (0.2309699292 * s),
   (-1.2684380046 * l) + (2.6097574011 * m) - (0.3413193965 * s),
   (-0.0041960863 * l) - (0.7034186147 * m) + (1.7076147010 * s)]
end

# Reduces chroma until the color fits in sRGB.
def oklch(lightness, chroma, hue)
  chroma -= 0.002 while chroma.positive? &&
                        !oklch_to_linear_rgb(lightness, chroma, hue).all? { _1.between?(-1e-4, 1 + 1e-4) }
  rgb = oklch_to_linear_rgb(lightness, chroma, hue)
  "##{rgb.map { format('%02x', (to_srgb(_1.clamp(0.0, 1.0)) * 255).round) }.join}"
end

def luminance(hex)
  r, g, b = hex.delete('#').scan(/../).map { to_linear(_1.to_i(16) / 255.0) }
  (0.2126 * r) + (0.7152 * g) + (0.0722 * b)
end

def contrast(a, b) = ([luminance(a), luminance(b)].max + 0.05) / ([luminance(a), luminance(b)].min + 0.05)

accent_lightness, _, accent_hue = hex_to_oklch(ACCENT)
neutral = ->(lightness, chroma = 0.012) { oklch(lightness, chroma, accent_hue) }

background = neutral.(0.155, 0.006)
foreground = oklch(0.78, 0.17, accent_hue)
palette = { 0 => neutral.(0.24), 7 => neutral.(0.84, 0.015), 8 => neutral.(0.52, 0.02), 15 => neutral.(0.96, 0.01) }
HUES.each do |slot, hue|
  palette[slot] = oklch(accent_lightness, CHROMA, hue)
  palette[slot + 8] = oklch(BRIGHT_LIGHTNESS, CHROMA * 0.85, hue)
end

puts <<~THEME
  background = #{background}
  foreground = #{foreground}
  cursor-color = #{ACCENT}
  cursor-text = #{background}
  selection-background = #{ACCENT}
  selection-foreground = #{background}

THEME
(0..15).each { puts "palette = #{_1}=#{palette[_1]}" }

ratios = palette.merge('fg' => foreground, 'accent' => ACCENT).map { |k, v| "#{k}=#{contrast(v, background).round(1)}" }
$stderr.puts "contrast vs background: #{ratios.join(' ')}"
