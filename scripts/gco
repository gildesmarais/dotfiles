#!/usr/bin/env bash
#
# gco
#
# Switches git branches; prints a directory for shell wrappers to `cd` into
# when the branch is already checked out in another worktree.
# - gco              => fzf picker over local and remote branches
# - gco <branch>     => switch, or hop to the worktree holding <branch>
# - gco main|master  => the default branch, whichever name the repo uses
# - gco -b <branch>  => `git switch -c`, for checkout muscle memory
# - gco <args...>    => passed through to `git switch`
#
# Git output goes to stderr; stdout carries only the worktree path.

set -euo pipefail

# worktree_for <branch>: path of the worktree holding <branch>, if any.
worktree_for() {
  git worktree list --porcelain | awk -v ref="refs/heads/$1" '
    /^worktree / { path = substr($0, 10) }
    $0 == "branch " ref { print path; exit }
  '
}

# switch_or_hop <branch> <git switch args...>
switch_or_hop() {
  local branch="$1" path current
  shift
  path="$(worktree_for "$branch")"
  current="$(git rev-parse --show-toplevel)"

  if [ -n "$path" ] && [ "$path" != "$current" ]; then
    echo "gco: '$branch' is checked out in $path" >&2
    printf '%s\n' "$path"
    return 0
  fi

  git switch "$@" >&2
}

# default_branch: origin's HEAD branch, e.g. main or master.
default_branch() {
  git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@'
}

# checkout muscle memory: -b/-B create a branch, as -c/-C do for switch.
case "${1:-}" in
  -b) set -- -c "${@:2}" ;;
  -B) set -- -C "${@:2}" ;;
esac

# main and master both mean the default branch when the named one is absent.
case "${1:-}" in
  main | master)
    if [ $# -eq 1 ] && ! git show-ref --verify --quiet "refs/heads/$1"; then
      set -- "$(default_branch)"
      [ -n "$1" ] || { echo "gco: origin/HEAD is unset; run git remote set-head origin -a" >&2; exit 1; }
    fi
    ;;
esac

if [ $# -eq 0 ]; then
  ref="$(
    git for-each-ref --format='%(refname:short)' refs/heads refs/remotes |
      rg -v '^origin/HEAD$' |
      fzf
  )" || exit 1

  case "$ref" in
    origin/*)
      branch="${ref#origin/}"
      path="$(worktree_for "$branch")"
      if [ -n "$path" ]; then
        switch_or_hop "$branch" "$branch"
      else
        git switch --track "$branch" 2>/dev/null >&2 ||
          git switch "$branch" 2>/dev/null >&2 ||
          git switch -c "$branch" --track "$ref" >&2
      fi
      ;;
    *)
      switch_or_hop "$ref" "$ref"
      ;;
  esac
elif [ $# -eq 1 ] && [ "${1#-}" = "$1" ]; then
  switch_or_hop "$1" "$1"
else
  git switch "$@" >&2
fi
