font-size = 18
theme = neon-ember
cursor-style = block
unfocused-split-opacity = 0.85
window-padding-x = 8
copy-on-select = true

# --- Keybindings ---
keybind = super+p=scroll_page_up
keybind = super+d=scroll_page_down
keybind = shift+up=scroll_page_up
keybind = shift+down=scroll_page_down
keybind = super+k=clear_screen
